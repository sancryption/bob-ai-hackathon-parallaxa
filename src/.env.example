# SafetyReady — environment variables
# Copy this file to .env and adjust values.  Never commit .env.

# --- Backend ---
# SQLite file path (relative to src/backend/)
DATABASE_URL=sqlite:///./safetyready.db

# Uvicorn port
APP_PORT=8000

# "development" enables SQL echo; use "production" to silence it
APP_ENV=development

# --- Frontend ---
# URL of the running FastAPI backend (used by Vite at build time)
VITE_API_URL=http://localhost:8000
